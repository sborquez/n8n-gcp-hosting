{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2019",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "lib": ["es2019", "dom"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["node_modules/n8n-workflow/dist/*"]
    },
    "skipLibCheck": true
  },
  "include": ["nodes/**/*", "credentials/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
